<?xml version="1.0"?>
<!-- Planar 2-link arm. Both joints turn about the y axis, so the arm moves in the vertical x-z plane.
     Each link is a thin rod of length 1 m and mass 1 kg; its centre of mass sits at mid-length. -->
<robot name="arm2">
  <link name="base"/>
  <link name="link1">
    <inertial>
      <origin xyz="0 0 -0.5"/>
      <mass value="1.0"/>
      <!-- rod about its centre: m l^2 / 12 = 1/12 on the two axes perpendicular to the rod -->
      <inertia ixx="0.0833333333" iyy="0.0833333333" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="link2">
    <inertial>
      <origin xyz="0 0 -0.5"/>
      <mass value="1.0"/>
      <inertia ixx="0.0833333333" iyy="0.0833333333" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 2.5"/>
    <axis xyz="0 1 0"/>
    <!-- very wide bounds: never reached, but keeps n_q = n_v = 2 in Pinocchio -->
    <limit lower="-100" upper="100" effort="1000" velocity="1000"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 -1.0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-100" upper="100" effort="1000" velocity="1000"/>
  </joint>
</robot>
